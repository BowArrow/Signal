{
  "name": "signal",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing operations system for a solo founder. Finds threads worth answering, drafts a reply, queues it for human approval, tracks what converted.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "out/main/index.cjs",
  "scripts": {
    "signal": "tsx src/cli/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/index.ts db migrate",
    "db:seed": "tsx src/cli/index.ts db seed",
    "ingest": "tsx src/cli/index.ts ingest run",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "pnpm build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "postinstall": "node scripts/rebuild-native.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "better-sqlite3": "^11.10.0",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "fast-xml-parser": "^5.2.3",
    "nanoid": "^5.1.5",
    "node-cron": "^3.0.3",
    "zod": "^3.25.51"
  },
  "build": {
    "appId": "com.aionx.signal",
    "productName": "Signal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "native/better_sqlite3-electron.node",
        "to": "native/better_sqlite3-electron.node"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.28.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.29",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.1.4",
    "drizzle-kit": "^0.31.1",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
