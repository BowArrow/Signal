rules_version = '2';

// Deny everything. Nothing in Signal's edge is read or written by a browser
// client: the Cloud Functions use the Admin SDK, which bypasses these rules
// entirely, and the desktop app pulls through an authenticated function.
//
// If a rule ever needs relaxing here, that is a sign the architecture drifted
// and something client-side started talking to the database directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
